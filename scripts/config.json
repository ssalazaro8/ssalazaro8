  "languages": {
    "python": [".py"],
    "javascript": [".js", ".jsx"],
    "typescript": [".ts", ".tsx"],
    "java": [".java"],
    "csharp": [".cs"],
    "cpp": [".cpp", ".cc", ".cxx", ".h++"],
    "c": [".c", ".h"],
