{
  "github": {
    "username": "ssalazaro8",
    "fetch_remote": false,
    "ignore_forks": false
  },
  "analyzer": {
    "ignore_directories": [
      "node_modules",
      "venv",
      "env",
      ".git",
      "__pycache__",
      "dist",
      "build",
      ".next",
      ".nuxt",
      "coverage",
      "temp",
      "tmp"
    ],
    "ignore_files": [
      ".gitignore",
      ".gitkeep",
      "LICENSE",
      ".env",
      ".env.local"
    ]
  },
  "display": {
    "top_languages": 10,
    "top_frameworks": 20,
    "top_databases": 15,
    "language_min_files": 1,
    "framework_min_count": 1
  },
  "frameworks": {
